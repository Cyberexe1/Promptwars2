# Copy this file to .env for local development. Never commit the real .env file.
# The server reads .env automatically via Node's built-in loader. In production
# App Runner supplies these values directly, so no .env file is deployed.

# Server
NODE_ENV=development
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upstream air-quality provider (Open-Meteo requires no API key).
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
UPSTREAM_TIMEOUT_MS=6000

# ---------------------------------------------------------------------------
# Amazon Bedrock
# ---------------------------------------------------------------------------
# Leave BEDROCK_MODEL_ID empty to run on the deterministic rules engine only.
# The app is fully functional in that mode and reports generatedBy: "rules".
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_TIMEOUT_MS=12000

# Credentials come from the standard AWS provider chain. In order of preference:
#
#   1. Production: the App Runner instance role. No keys exist anywhere.
#   2. Local development: `aws configure sso` or a named profile, then set
#      AWS_PROFILE below. Credentials stay in ~/.aws and never touch this repo.
#   3. Last resort only: long-lived access keys. These do not expire, cannot be
#      revoked selectively, and are the most common cause of leaked AWS
#      credentials. If you must use them, the names have to be exactly these,
#      because the AWS SDK looks for these specific variables:
#
# AWS_PROFILE=my-sso-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------
# HMAC key for session cookies. Anyone holding this value can forge a session
# for any account, so treat it like a password.
#
# Leave it empty for local development: a random key is generated at start-up,
# which means sessions do not survive a restart. That is the safer default.
# In production the server refuses to start unless this is at least 32
# characters; the CloudFormation stack generates one into Secrets Manager.
SESSION_SECRET=

# Accounts live in DynamoDB. Without a table name they are held in memory and
# lost on restart, which is fine locally and never fine in production.
DYNAMODB_TABLE_NAME=

# How long a cached air-quality reading is reused. Zero disables caching.
AQI_CACHE_TTL_SECONDS=600

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Credential endpoints get a far tighter budget, because password hashing is
# expensive by design and these are the endpoints worth brute-forcing.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
